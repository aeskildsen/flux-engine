# The UGens that flux-engine adds to SuperSonic's engine. SuperSonic's
# dsp/scsynth/CMakeLists.txt includes this file when SCSYNTH_EXTRA_PLUGINS
# points to it (patches/supersonic-extra-plugins.patch adds that hook).
#
# scripts/prepare.sh writes the generated UGen sources to build/generated.
# Each UGen needs an entry here and a load call in extra-plugins.h.

set(FLUX_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
set(FLUX_ENGINE_GENERATED "${FLUX_ENGINE_ROOT}/build/generated")

# Faust UGens: generated by faust with the supercollider.cpp architecture, then
# made static by scripts/faust-static-ugen.py. SC_FAUST_PREFIX gives the unit
# its name prefix: the Faust name "woodbar" becomes the UGen PhysWoodbar.
set(FLUX_ENGINE_FAUST_SOURCES
    "${FLUX_ENGINE_GENERATED}/Woodbar.cpp")
list(APPEND SCSYNTH_PLUGIN_SOURCES ${FLUX_ENGINE_FAUST_SOURCES})
set_source_files_properties(${FLUX_ENGINE_FAUST_SOURCES} PROPERTIES
    INCLUDE_DIRECTORIES "${FLUX_ENGINE_ROOT}/vendor/faust"
    COMPILE_DEFINITIONS "SC_FAUST_PREFIX=\"Phys\"")

set(SCSYNTH_EXTRA_PLUGINS_HEADER "${CMAKE_CURRENT_LIST_DIR}/extra-plugins.h")
