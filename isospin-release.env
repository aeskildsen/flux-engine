# The isospin release that the engine takes its static UGen sources from
# (https://github.com/aeskildsen/isospin/releases). scripts/prepare.sh
# downloads the tarball and checks it against this SHA-256. To change the
# release, change both values together.
ISOSPIN_RELEASE_VERSION=0.1.0
ISOSPIN_RELEASE_SHA256=33d79073fcec148321b9b0238b89424e2cbdbcb583188776ff093267ef45292a
