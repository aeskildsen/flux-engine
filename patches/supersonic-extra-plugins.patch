 // TAU NOTE: Dynamic plugin loading code has been removed.
 // SuperSonic compiles with -DSTATIC_PLUGINS — all UGen plugins are statically
@@ -147,5 +151,8 @@ void initialize_library(const char* uGensPluginPath) {
     DemoUGens_Load(&gInterfaceTable);
     LinkUGen_Load(&gInterfaceTable);
     SPLimiterUGen_Load(&gInterfaceTable);
+#    ifdef SC_EXTRA_PLUGINS_HEADER
+    SC_ExtraPlugins_Load(&gInterfaceTable);
+#    endif
 #endif // STATIC_PLUGINS
 }
