# The version of the engine package that scripts/package.py makes. The form is
# <SuperSonic version>-flux.<n>: the SuperSonic version must be the version in
# supersonic/package.json, and n counts the flux-engine releases on that
# SuperSonic version. Increase n for each release; set it back to 1 when
# SuperSonic changes.
FLUX_ENGINE_VERSION=0.91.0-flux.1
